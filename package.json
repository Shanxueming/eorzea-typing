{
  "name": "eorzea-typing",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run && tsx scripts/smoke-coop.ts && tsx scripts/smoke-account.ts",
    "test:unit": "vitest run",
    "test:coop": "tsx scripts/smoke-coop.ts",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "build": "pnpm --filter @eorzea/web build",
    "start": "pnpm --filter @eorzea/server start",
    "test:account": "tsx scripts/smoke-account.ts"
  },
  "dependencies": {
    "@eorzea/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "ws": "^8.18.0"
  }
}
